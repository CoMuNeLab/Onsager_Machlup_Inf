.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C++ build artifacts
*.so
*.o
*.a
gene_expr/build/
gene_expr/*.so

# Archived legacy experiments, results, and scratchpad
/old/

# LaTeX build artifacts
text/*.aux
text/*.bbl
text/*.blg
text/*.fdb_latexmk
text/*.fls
text/*.log
text/*.synctex.gz
text/*.out

# Jupyter checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Raw simulation trajectories (hundreds of MB of individual trial directories)
results/grid_results/N*
results/grid_results_er/N*

# Ensure summary metrics and benchmark results are tracked
!results/grid_results/performance_metrics.csv
!results/grid_results_er/performance_metrics.csv
!results/benchmarking/**
!results/perturbation/**